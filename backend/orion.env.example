# Орион (веб) — скопируйте нужное в backend/.env. Ключи НЕ коммитить.
# Режим 3 «ИИ-агент сервиса» (OpenAI-совместимый API или anthropic):
ORION_LLM_PROVIDER=openai
ORION_LLM_BASE_URL=
ORION_LLM_MODEL=
ORION_LLM_API_KEY=
ORION_LLM_VISION=0
ORION_LLM_TIMEOUT=30
ORION_HOSTED_ENABLED=0
# Админ-API /api/orion/admin/* (заголовок X-Orion-Admin), длинная случайная строка:
ORION_ADMIN_TOKEN=
# Режим 4 «Участник разработки» — общий kill switch и лимит предложений:
ORION_CONTRIB_ENABLED=0
ORION_CONTRIB_RATE_PER_HOUR=5
ORION_CHAT_RATE_PER_MIN=20
# BYO: разрешить http:// и локальные/частные адреса (только для локальной разработки, напр. Ollama):
ORION_BYO_ALLOW_HTTP=0
ORION_BYO_ALLOW_PRIVATE=0
# На будущее (реальная интеграция contributor, пока не используется):
# ORION_GITHUB_APP_ID=
# ORION_GITHUB_PRIVATE_KEY_FILE=
# ORION_GITHUB_REPO=
